window.addEventListener("DOMContentLoaded", function () {
    const botoes = document.querySelectorAll(".botao");
    const textos = document.querySelectorAll(".conteudo-objetivo");

    botoes.forEach(function (botao, indice) {
        botao.addEventListener("click", function () {
            // Remove 'ativo' de todos os botões e abas
            for (let i = 0; i < botoes.length; i++) {
                botoes[i].classList.remove("ativo");
                textos[i].classList.remove("ativo");
            }

            // Adiciona 'ativo' apenas no botão e aba clicados
            botao.classList.add("ativo");
            textos[indice].classList.add("ativo");
        });
    });
});
const botoes = document.querySelectorAll(".botao");
const textos = document.querySelectorAll(".conteudo-objetivo");

// Este laço passa por CADA UM dos 4 botões
for (let i = 0; i < botoes.length; i++) {
    botoes[i].onclick = function () {
        // 1. Remove a classe "ativo" de TODOS os 4 botões e das 4 caixas
        for (let j = 0; j < botoes.length; j++) {
            botoes[j].classList.remove("ativo");
            textos[j].classList.remove("ativo");
        }

        // 2. Adiciona a classe "ativo" APENAS no botão e na caixa correspondente ao clique
        botoes[i].classList.add("ativo");
        textos[i].classList.add("ativo");
    }
}
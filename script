const botoes = document.querySelectorAll(".botao");
const titulo = document.getElementById("titulo");
const lista = document.getElementById("lista");

const objetivos = [
{
    titulo: "Curso de inglês",

    processos: [
        "Estudar 30 minutos por dia",
        "Aprender novas palavras diariamente",
        "Praticar conversação",
        "Assistir filmes e séries em inglês",
        "Fazer exercícios da plataforma"
    ]
},

{
    titulo: "Passar no ENEM",

    processos: [ 
        "Estudar todas as áreas do conhecimento",
        "Resolver questões antigas",
        "Fazer simulados mensalmente",
        "Treinar redação toda semana",
        "Revisar os conteúdos com frequência"
    ]
},

{
    titulo: "Ingressar-me profissionalmente",

    processos: [ 
        "Desenvolver projetos pessoais",
        "Criar um portfólio",
        "Fazer cursos de qualificação",
        "Enviar currículos para empresas",
        "Preparar-me para entrevistas"]
},

{
    titulo: "Currículo",

    processos: []
}

];

function mostrarObjetivo(indice){

    titulo.textContent = objetivos[indice].titulo;

    lista.innerHTML = "";

    objetivos[indice].processos.forEach(processo => {

        const item = document.createElement("li");
        item.textContent = processo;
        lista.appendChild(item);

    });

}

botoes.forEach((botao, indice) => {

    botao.addEventListener("click", () => {
        mostrarObjetivo(indice);
    });

});

// Mostra o primeiro objetivo ao abrir a página
mostrarObjetivo(0);

// Seleciona todos os 4 botões e todas as 4 caixas de conteúdo
const botoes = document.querySelectorAll(".botao");
const textos = document.querySelectorAll(".conteudo-objetivo");

// Alternar abas ao clicar nos botões
for (let i = 0; i < botoes.length; i++) {
    botoes[i].onclick = function () {
        for (let j = 0; j < botoes.length; j++) {
            botoes[j].classList.remove("ativo");
            textos[j].classList.remove("ativo");
        }

        botoes[i].classList.add("ativo");
        textos[i].classList.add("ativo");
    }
}

// Atualiza o link do botão dinamicamente quando o usuário digita na caixa do LinkedIn
const inputLinkedin = document.getElementById("input-linkedin");
const btnLinkedin = document.getElementById("btn-linkedin");

if (inputLinkedin && btnLinkedin) {
    inputLinkedin.addEventListener("input", function () {
        let url = inputLinkedin.value.trim();
        if (url !== "" && !url.startsWith("http://") && !url.startsWith("https://")) {
            url = "https://" + url;
        }
        btnLinkedin.href = url;
    });
}
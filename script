document.addEventListener("DOMContentLoaded", function () {
    const botoes = document.querySelectorAll(".botao");
    const textos = document.querySelectorAll(".conteudo-objetivo");

    // Adiciona o evento de clique em todos os botões
    botoes.forEach((botao, indice) => {
        botao.addEventListener("click", () => {
            // Remove a classe ativo de todos os botões e conteúdos
            botoes.forEach(b => b.classList.remove("ativo"));
            textos.forEach(t => t.classList.remove("ativo"));

            // Adiciona a classe ativo apenas no botão e no conteúdo clicado
            botao.classList.add("ativo");
            if (textos[indice]) {
                textos[indice].classList.add("ativo");
            }
        });
    });
});